                android:pathData="M41,22v8M49,22v8M57,22v8M65,22v8" />
            <!-- Colonne des scores et trois lignes -->
            <path android:strokeColor="#A8A097" android:strokeWidth="1.2"
                android:pathData="M52,36v36" />
            <path android:strokeColor="#E8E0D5" android:strokeWidth="2.4" android:strokeLineCap="round"
                android:pathData="M38,42h10M56,42h9M38,52h8M56,52h11M38,62h11M56,62h7" />
        </group>
        <!-- Crayon -->
        <group android:rotation="35" android:pivotX="76" android:pivotY="58">
            <path android:fillColor="#EF5350" android:pathData="M72,30h8v36h-8Z" />
            <path android:fillColor="#E8E0D5" android:pathData="M72,66h8l-4,9Z" />
            <path android:fillColor="#121212" android:pathData="M74.6,71h2.8l-1.4,4Z" />
            <path android:fillColor="#D5DCE2" android:pathData="M72,26h8v4h-8Z" />
