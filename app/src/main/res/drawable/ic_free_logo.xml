    <group android:translateY="-12">
        <!-- Carnet -->
        <group android:rotation="-6" android:pivotX="54" android:pivotY="60">
            <path android:fillColor="#121212" android:strokeColor="#E8E0D5" android:strokeWidth="1.5"
                android:pathData="M37,26h30a4,4 0,0 1,4 4v44a4,4 0,0 1,-4 4h-30a4,4 0,0 1,-4 -4v-44a4,4 0,0 1,4 -4Z" />
